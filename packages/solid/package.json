{
  "name": "@base-ui/solid",
  "version": "1.7.0",
  "private": true,
  "author": "MUI Team",
  "description": "Base UI Solid is a library of headless ('unstyled') SolidJS components with an API surface identical to @base-ui/react.",
  "license": "MIT",
  "keywords": [
    "solid",
    "solidjs",
    "solid-component",
    "mui",
    "unstyled",
    "base-ui",
    "a11y"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dogmar/base-ui-solid.git",
    "directory": "packages/solid"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*/index.ts",
    "./merge-props": "./src/merge-props/index.ts",
    "./use-render": "./src/use-render/index.ts",
    "./internals/*": "./src/internals/*.ts"
  },
  "imports": {
    "#test-utils": "./test/index.ts"
  },
  "scripts": {
    "typescript": "tsc -p tsconfig.json",
    "test": "vitest"
  },
  "dependencies": {
    "@base-ui/utils": "workspace:*",
    "@floating-ui/dom": "^1.7.4",
    "@floating-ui/utils": "^0.2.12",
    "@solidjs/web": "2.0.0-rc.4",
    "solid-js": "2.0.0-rc.4"
  },
  "devDependencies": {
    "@solidjs/testing-library": "1.0.0-beta.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "14.6.3",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite-plugin-solid": "3.0.0-next.27",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "solid-js": "^2.0.0-rc.0"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=14.0.0"
  }
}
